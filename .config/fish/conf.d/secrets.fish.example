# Copy this file to ~/.config/fish/conf.d/secrets.fish and fill in your real values.
# The real file is gitignored (see .gitignore) so secrets stay out of version control.
# Fish auto-sources every *.fish file in conf.d/ at startup.

# Enable OpenCode's Exa-backed web search tool.
set -gx OPENCODE_ENABLE_EXA 1
# Exa API key used by OpenCode's websearch tool to raise rate limits.
set -gx EXA_API_KEY your_key_here
