# name: 'rogs'
# Tangled from ~/.config/fish/README.org. Edit that file, not this one.

[dark]
# preferred_background: 0a0a0a
fish_color_normal eeeeee
fish_color_command 79fb9b
fish_color_keyword 50fa7b
fish_color_param eeeeee
fish_color_option 56b6c2
fish_color_quote 6ba1e6
fish_color_redirection 56b6c2
fish_color_end 56b6c2
fish_color_operator e5c07b
fish_color_escape e5c07b
fish_color_comment 808080
fish_color_autosuggestion 808080
fish_color_error e06c75
fish_color_cancel --reverse
fish_color_cwd 6ba1e6
fish_color_cwd_root e06c75
fish_color_user 50fa7b
fish_color_host eeeeee
fish_color_host_remote e5c07b
fish_color_status e06c75
fish_color_match 50fa7b
fish_color_history_current --bold
fish_color_valid_path --underline
fish_color_search_match --background=0a501f
fish_color_selection --background=0a501f
fish_pager_color_completion eeeeee
fish_pager_color_description 808080
fish_pager_color_prefix 50fa7b --bold --underline
fish_pager_color_progress 0a0a0a --background=50fa7b
fish_pager_color_selected_background --background=1e1e1e

