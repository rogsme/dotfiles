/**
 *
 * | '__/ _ \ / _` / __|    Roger González
 * | | | (_) | (_| \__ \    https://rogs.me
 * |_|  \___/ \__, |___/    https://git.rogs.me
 *            |___/
 *
 * ROFI Color theme
 * User: rogs
 * Copyright: Roger Gonzalez
 *
 * Colors from the dark rogs opencode theme (~/.config/opencode/themes/rogs.json), the same ones the
 * Claude Code, Ghostty, Herdr and Polybar themes use. The window is a raised dialog, like opencode's.
 */
* {
    /* rogs palette */
    green:                       #50fa7b;
    text:                        #eeeeee;
    muted:                       #808080;
    subtle:                      #4c4c4c;
    raised:                      #141414;
    inverse:                     #0a0a0a;
    red:                         #e06c75;
    blue:                        #6ba1e6;
    cyan:                        #56b6c2;
    lightbg:                     #fff7f1;
    lightfg:                     @muted;

    foreground:                  @text;
    background:                  @raised;
    background-color:            transparent;
    border-color:                @green;
    bordercolor:                 @green;
    separatorcolor:              @subtle;
    spacing:                     2;

    normal-foreground:           @foreground;
    normal-background:           transparent;
    alternate-normal-foreground: @foreground;
    alternate-normal-background: transparent;
    selected-normal-foreground:  @inverse;
    selected-normal-background:  @green;

    active-foreground:           @cyan;
    active-background:           transparent;
    alternate-active-foreground: @active-foreground;
    alternate-active-background: transparent;
    selected-active-foreground:  @inverse;
    selected-active-background:  @green;

    urgent-foreground:           @red;
    urgent-background:           transparent;
    alternate-urgent-foreground: @urgent-foreground;
    alternate-urgent-background: transparent;
    selected-urgent-foreground:  @inverse;
    selected-urgent-background:  @red;
}
#window {
    background-color: @background;
    border:           1;
    padding:          5;
}
#mainbox {
    border:  0;
    padding: 0;
}
#message {
    border:       1px dash 0px 0px ;
    border-color: @separatorcolor;
    padding:      1px ;
}
#textbox {
    text-color: @foreground;
}
#listview {
    fixed-height: 0;
    border:       2px dash 0px 0px ;
    border-color: @separatorcolor;
    spacing:      2px ;
    scrollbar:    true;
    padding:      2px 0px 0px ;
}
#element {
    border:  0;
    padding: 1px ;
}
#element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
#element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
#element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
#element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
#element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
#element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}
#element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
#element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
#element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}
#scrollbar {
    width:        4px ;
    border:       0;
    handle-width: 8px ;
    padding:      0;
}
#sidebar {
    border:       2px dash 0px 0px ;
    border-color: @separatorcolor;
}
#button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
#inputbar {
    spacing:    0;
    text-color: @normal-foreground;
    padding:    1px ;
}
#case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}
#entry {
    spacing:    0;
    text-color: @normal-foreground;
}
#prompt {
    spacing:    0;
    text-color: @green;
}
#inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}
#textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.3em 0em 0em ;
    text-color: @muted;
}
