{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "plan",
  "agents": {
    "plan": {
      "model": "openai/gpt-6.1-sol#max"
    },
    "build": {
      "model": "openai/gpt-6.1-sol#high"
    },
    "title": {
      "model": "lazer/deepseek-v4.1-flash"
    },
    "explore": {
      "model": "lazer/deepseek-v4.1-flash#low"
    },
    "general": {
      "model": "openai/gpt-6.1-sol#high"
    }
  },
  "formatter": true,
  "websearch": {
    "provider": "random"
  },
  "compaction": {
    "keep": {
      "tokens": 24000
    }
  },
  "experimental": {
    "subagent_depth": 2,
    "todo": true
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.claude/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.claude/*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/home/roger/.local/share/rtk/tee/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/roger/.agents/skills/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/home/roger/.agents/skills/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/home/roger/.agents/skills/*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  // Lazer's model inventory is managed by plugins/lazer-models, refreshed every 15 minutes.
  "providers": {
    "lazer": {
      "name": "Lazer",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://proxy.lazertechnologies.com/"
      }
    }
  }
}
