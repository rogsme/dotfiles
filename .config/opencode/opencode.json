{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "plan",
  "agents": {
    "plan": {
      "model": "openai/gpt-6.1-sol#max"
    },
    "build": {
      "model": "openai/gpt-6.1-sol#high"
    },
    "title": {
      "model": "lazer/glm-5.3-flash"
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "experimental": {
    "subagent_depth": 2
  },
  "instructions": [
    "~/.config/opencode/instructions/shell-strategy/shell_strategy.md"
  ],
  "permissions": [
    {
      "action": "read",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "plan-reviewer",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rtk *",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.claude/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.claude/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.claude/*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "/home/roger/.local/share/rtk/tee/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/home/roger/.local/share/rtk/tee/*",
      "effect": "allow"
    }
  ],
  "plugins": [
    "@prevalentware/opencode-goal-plugin"
  ],
  "providers": {
