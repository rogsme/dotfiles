{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "rogs"
  },
  "keybinds": {
    "app.exit": "ctrl+c"
  },
  "scroll": {
    "acceleration": false
  },
  "diffs": {
    "wrap": "word",
    "source": "turn",
    "tree": true,
    "view": "auto"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "mode": "auto"
  },
  "prompt": {
    "image_preview": true
  }
}
